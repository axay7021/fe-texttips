{
  "name": "my-better-auth-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- sh -c 'next dev -p ${PORT:-3000}'",
    "build": "next build",
    "start": "dotenv -e .env -- sh -c 'next start -p ${PORT:-3000}'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "echo \"No tests specified. Skipping...\" && exit 0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
