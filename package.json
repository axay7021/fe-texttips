    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=10.0.0",
    "yarn": "please-use-pnpm"
