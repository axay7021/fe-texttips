    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "next": "16.1.0",
    "nodemailer": "^7.0.12",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-qr-code": "^2.0.18",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
